# ─────────────────────────────────────────────
# PROP MONITOR - Environment Variables
# ─────────────────────────────────────────────
# Copy this to .env and fill in the values for your deployment

# Appwrite Configuration
VITE_APPWRITE_ENDPOINT=https://backend.071098v2.duckdns.org/v1
VITE_APPWRITE_PROJECT_ID=propertymonitor
VITE_APPWRITE_DATABASE_ID=belrealty-db
VITE_APPWRITE_API_KEY=

# Scraper Server URL (your Coolify deployment of scraper-server)
VITE_SCRAPER_API_URL=https://scrap.071098v2.duckdns.org

# Demo mode (disables auth for testing)
VITE_DEMO_MODE=false