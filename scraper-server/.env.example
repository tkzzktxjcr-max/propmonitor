# ─────────────────────────────────────────────
# APPWRITE CONFIGURATION (Required)
# ─────────────────────────────────────────────
APPWRITE_ENDPOINT=https://your-appwrite-instance.example.com/v1
APPWRITE_PROJECT=your-project-id
APPWRITE_API_KEY=your-api-key
APPWRITE_DATABASE_ID=your-database-id

# ─────────────────────────────────────────────
# SERVER CONFIGURATION
# ─────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ─────────────────────────────────────────────
# BROWSER (PUPPETEER) CONFIGURATION
# ─────────────────────────────────────────────
# Path to Chromium binary (default in Docker: /usr/bin/chromium)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Run browser in headless mode (keep true in production)
BROWSER_HEADLESS=true
# Browser timeout in milliseconds
BROWSER_TIMEOUT=60000
# Maximum concurrent browser pages
BROWSER_MAX_PAGES=5

# ─────────────────────────────────────────────
# RATE LIMITING CONFIGURATION
# ─────────────────────────────────────────────
# Delay between requests in milliseconds
REQUEST_DELAY_MS=2000
# Random jitter added to delay (milliseconds)
REQUEST_JITTER_MS=1000
# Maximum concurrent scraping jobs
MAX_CONCURRENT_JOBS=3
# Rate limit window in milliseconds
RATE_LIMIT_WINDOW_MS=60000
# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=10

# ─────────────────────────────────────────────
# SCRAPER CONFIGURATION
# ─────────────────────────────────────────────
# Maximum search pages to scrape per job
MAX_PAGES=5
# Maximum retries for failed requests
MAX_RETRIES=3
# Base delay for retry backoff (milliseconds)
RETRY_BASE_DELAY=2000
# Timeout for detail page extraction (milliseconds)
DETAIL_TIMEOUT=30000

# ─────────────────────────────────────────────
# PROXY CONFIGURATION (Optional)
# ─────────────────────────────────────────────
# PROXY_ENABLED=false
# PROXY_URL=http://proxy.example.com:8080
# PROXY_USERNAME=
# PROXY_PASSWORD=

# ─────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────
# LOG_LEVEL=info